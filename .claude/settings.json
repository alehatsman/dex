{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "dex hook inject",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "dex hook redirect",
            "type": "command"
          }
        ],
        "matcher": "Read|ReadFile|read_file"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "dex hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "dex hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "dex hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
